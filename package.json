{
  "name": "megapush",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "node -e \"console.log('MegaPush static + functions ready')\"",
    "cf:deploy": "npm install && npx wrangler pages deploy public --project-name megapush --commit-dirty=true",
    "cf:dev": "npx wrangler pages dev public --compatibility-flags=nodejs_compat"
  },
  "dependencies": {
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "wrangler": "^4.14.0"
  }
}
